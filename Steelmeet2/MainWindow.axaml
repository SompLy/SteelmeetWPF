<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Steelmeet2.MainWindow"
        Title="STEELMEET 2.0" Width="1180" Height="780"
        Background="#0b0f14" TransparencyLevelHint="None"
       
        FontSize="15">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0b0f14" />
    <SolidColorBrush x:Key="Surface" Color="#121820" />
    <SolidColorBrush x:Key="Surface2" Color="#172030" />
    <SolidColorBrush x:Key="Border" Color="#1f2731" />
    <SolidColorBrush x:Key="Text" Color="#e6ebf3" />
    <SolidColorBrush x:Key="Muted" Color="#8b97a6" />
    <SolidColorBrush x:Key="Accent" Color="#4f8cff" />
    <SolidColorBrush x:Key="Ok" Color="#37c98b" />
    <SolidColorBrush x:Key="Bad" Color="#ff5f68" />
  </Window.Resources>

  <Grid ColumnDefinitions="230,*" >
    <!-- Vänster-räl: SteamOS-kompakt tile-nav -->
    <Border Grid.Column="0" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="6" Margin="10,14">
        <Image Source="avares://Steelmeet2/SMLogoWhite.png" Width="196" HorizontalAlignment="Left" Margin="6,0,0,0" />
        <TextBlock Text="2.0" FontFamily="JetBrains Mono" FontSize="11" Foreground="{StaticResource Accent}" Margin="6,0,0,18" />
        <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="Nav_SelectionChanged">
          <ListBoxItem Padding="12,11"><TextBlock Text="Invägning" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Tävling" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Domare" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Resultat" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Databas" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Inställningar" /></ListBoxItem>
        </ListBox>
        <Border Height="46" />
        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="10" BorderBrush="{StaticResource Border}" BorderThickness="1">
          <TextBlock x:Name="NetStatus" Text="● ONLINE" Foreground="{StaticResource Ok}" FontFamily="JetBrains Mono" FontSize="12" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Innehåll -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <!-- topprad -->
      <Border Grid.Row="0" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PageTitle" Text="Invägning" FontSize="19" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
          <TextBlock x:Name="Clock" Grid.Column="1" Text="--:--" Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- sidor (One per navigering, enkel visibility-växel) -->
      <Grid Grid.Row="1" Margin="18,14">
        <!-- Invägning: möteshantering + Excel + DB -->
        <Grid x:Name="PageWeighIn" IsVisible="True" RowDefinitions="Auto,*,Auto" Margin="0">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MeetName" Watermark="Mötesnamn" Width="220" />
              <TextBox x:Name="MeetDate" Watermark="yyyy-mm-dd" Width="110" />
              <TextBox x:Name="MeetPin" Watermark="PIN" PasswordChar="*" Width="80" />
              <Button x:Name="NewMeetBtn" Classes="sm-button" Content="SKAPA" MinHeight="36" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="LoadMeetsBtn" Classes="sm-button" Content="LISTA MÖTEN" MinHeight="36" />
              <ComboBox x:Name="MeetsCombo" Width="320" MinHeight="36" />
              <Button x:Name="OpenMeetBtn" Classes="sm-button" Content="ÖPPNA" MinHeight="36" />
              <Button x:Name="ImportBtn" Classes="sm-button" Content="IMPORTERA EXCEL" MinHeight="36" />
              <Button x:Name="ExportBtn" Classes="sm-button" Content="EXPORTERA EXCEL" MinHeight="36" />
              <Button x:Name="PublishBtn" Classes="sm-button" Content="PUBLICERA" MinHeight="36" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="#121820" BorderBrush="#1f2731" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="WeighInDg" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                      GridLinesVisibility="Vertical" RowHeight="30" FontFamily="JetBrains Mono" FontSize="12"
                      Foreground="#e6ebf3" Background="#121820" RowBackground="#121820" 
                      HorizontalGridLinesBrush="#1f2731" VerticalGridLinesBrush="#1f2731">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Grupp" Binding="{Binding groupNumber}" Width="56" />
                <DataGridTextColumn Header="Namn" Binding="{Binding name}" Width="170" />
                <DataGridTextColumn Header="Lot" Binding="{Binding lotNumber}" Width="46" />
                <DataGridTextColumn Header="Klass" Binding="{Binding weightClass}" Width="56" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding category}" Width="110" />
                <DataGridTextColumn Header="Licens" Binding="{Binding licenceNumber}" Width="70" />
                <DataGridTextColumn Header="Förening" Binding="{Binding accossiation}" Width="120" />
                <DataGridTextColumn Header="Vikt" Binding="{Binding bodyWeight}" Width="56" />
                <DataGridTextColumn Header="Höjd B" Binding="{Binding squatHeight}" Width="56" />
                <DataGridTextColumn Header="Infällt" Binding="{Binding tilted}" Width="52" />
                <DataGridTextColumn Header="Böj" Binding="{Binding s1}" Width="52" />
                <DataGridTextColumn Header="Höjd Bänk" Binding="{Binding benchHeight}" Width="56" />
                <DataGridTextColumn Header="Rack" Binding="{Binding benchRack}" Width="52" />
                <DataGridTextColumn Header="Avlyft" Binding="{Binding liftoff}" Width="52" />
                <DataGridTextColumn Header="Bänk" Binding="{Binding b1}" Width="52" />
                <DataGridTextColumn Header="Mark" Binding="{Binding d1}" Width="52" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <TextBlock Grid.Row="2" x:Name="WeighStatus" Text="klart." Foreground="#8b97a6" FontFamily="JetBrains Mono" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="PageComp" IsVisible="False" ColumnDefinitions="*,300">
          <!-- Vänster: kort + knappar + ordning -->
          <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" Margin="0,0,10,0">
            <UniformGrid Grid.Row="0" Columns="2">
              <!-- liftare #1 (nu) -->
              <Border x:Name="Info1Border" Background="#172030" CornerRadius="10" Padding="14" BorderBrush="#4f8cff" BorderThickness="1">
                <StackPanel Spacing="2">
                  <TextBlock x:Name="CompNowName" Text="—" FontSize="26" FontWeight="ExtraBold" Foreground="#e6ebf3" />
                  <TextBlock x:Name="CompNowAttempt" Text="försöksvikt" FontSize="16" FontFamily="JetBrains Mono" Foreground="#4f8cff" />
                  <TextBlock x:Name="CompNowHeights" Text="" FontSize="12" Foreground="#8b97a6" />
                  <TextBlock x:Name="CompNowExtras" Text="" FontSize="12" Foreground="#8b97a6" />
                </StackPanel>
              </Border>
              <!-- liftare #2 (nästa) -->
              <Border Background="#121820" CornerRadius="10" Padding="14" BorderBrush="#1f2731" BorderThickness="1" Margin="0,0,30,0">
                <StackPanel Spacing="2">
                  <TextBlock Text="NÄSTA" FontSize="10" Foreground="#8b97a6" />
                  <TextBlock x:Name="CompNextName" Text="—" FontSize="22" FontWeight="ExtraBold" Foreground="#e6ebf3" Opacity="0.85" />
                  <TextBlock x:Name="CompNextAttempt" Text="" FontSize="16" FontFamily="JetBrains Mono" Foreground="#8b97a6" />
                  <TextBlock x:Name="CompNextHeights" Text="" FontSize="12" Foreground="#8b97a6" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Timers: LIFT + LAPP -->
            <UniformGrid Grid.Row="1" Columns="2" Margin="0,10,0,0">
              <Border Background="#0e141d" CornerRadius="10" Padding="10" BorderBrush="#1f2731" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="LYFT-KLOCKA" FontSize="10" Foreground="#8b97a6" />
                  <TextBlock x:Name="TimerBig" Text="0:00" FontSize="40" FontFamily="JetBrains Mono" FontWeight="Bold" Foreground="#e6ebf3" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BarReadyBtn" Classes="sm-button" Content="BAR READY (1:00)" MinHeight="32" />
                    <ComboBox x:Name="LiftMinutesCob" Width="72" MinHeight="30" SelectedIndex="0">
                      <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" />
                      <ComboBoxItem Content="4" /><ComboBoxItem Content="5" />
                    </ComboBox>
                    <Button x:Name="LiftMinutesBtn" Classes="sm-button" Content="SÄTT MIN" MinHeight="32" />
                    <Button x:Name="LiftResetBtn" Classes="sm-button" Content="RESET" MinHeight="32" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Background="#0e141d" CornerRadius="10" Padding="10" BorderBrush="#1f2731" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock Text="LAPP-KLOCKA (tidsangivelse)" FontSize="10" Foreground="#8b97a6" />
                  <TextBlock x:Name="LappTimerBig" Text="0:00" FontSize="40" FontFamily="JetBrains Mono" FontWeight="Bold" Foreground="#8b97a6" />
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <ComboBox x:Name="StampHourCob" Width="58" MinHeight="30" SelectedIndex="0"><ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" /><ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" /><ComboBoxItem Content="7" /><ComboBoxItem Content="8" /><ComboBoxItem Content="9" /><ComboBoxItem Content="10" /><ComboBoxItem Content="11" /><ComboBoxItem Content="12" /><ComboBoxItem Content="13" /><ComboBoxItem Content="14" /><ComboBoxItem Content="15" /><ComboBoxItem Content="16" /><ComboBoxItem Content="17" /><ComboBoxItem Content="18" /><ComboBoxItem Content="19" /><ComboBoxItem Content="20" /><ComboBoxItem Content="21" /><ComboBoxItem Content="22" /></ComboBox>
                    <ComboBox x:Name="StampMinCob" Width="58" MinHeight="30" SelectedIndex="0"><ComboBoxItem Content="00" /><ComboBoxItem Content="15" /><ComboBoxItem Content="30" /><ComboBoxItem Content="45" /></ComboBox>
                    <Button x:Name="StampSetBtn" Classes="sm-button" Content="SÄTT KLOCKA" MinHeight="32" />
                    <Button x:Name="StampResetBtn" Classes="sm-button" Content="RESET" MinHeight="32" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- Domslut + nav -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Spacing="10" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="GoodBtn" Classes="sm-button" Background="#1c4d33" BorderBrush="#37c98b" Content="✓  GODKÄND" MinWidth="148" MinHeight="52" FontSize="16" />
                <Button x:Name="BadBtn" Classes="sm-button" Background="#5b1d22" BorderBrush="#ff5f68" Content="✗  MISSLYCKAD" MinWidth="150" MinHeight="52" FontSize="16" />
                <Button x:Name="UndoBtn" Classes="sm-button" Background="#4b3d16" BorderBrush="#f0b64b" Content="⤺  UNDO" MinWidth="110" MinHeight="52" FontSize="14" />
                <Button x:Name="RetryBtn" Classes="sm-button" Background="#4b3d16" BorderBrush="#f0b64b" Content="⟲  RETRY" MinWidth="106" MinHeight="52" FontSize="14" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="NextLifterBtn" Classes="sm-button" Content="NÄSTA LIFTARE" MinWidth="128" MinHeight="36" FontSize="12" />
              </StackPanel>
              <!-- Suggested weights -->
              <Border Background="#0e141d" CornerRadius="10" Padding="10" BorderBrush="#1f2731" BorderThickness="1">
                <StackPanel Spacing="6">
                  <TextBlock x:Name="SuggHeader" Text="VIKT-KORREKTERING (för vald liftare)" FontSize="10" Foreground="#8b97a6" />
                  <UniformGrid Rows="1">
                    <Button x:Name="Plus2_5" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus5" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus7_5" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus10" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus12_5" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus15" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus17_5" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus20" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Plus25" Classes="sm-wplus" Content="x" MinHeight="30" FontSize="11" />
                  </UniformGrid>
                  <UniformGrid Rows="1">
                    <Button x:Name="Minus2_5" Classes="sm-wminus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Minus5" Classes="sm-wminus" Content="x" MinHeight="30" FontSize="11" />
                    <Button x:Name="Minus7_5" Classes="sm-wminus" Content="x" MinHeight="30" FontSize="11" />
                    <TextBlock x:Name="RetryTag" Text="" VerticalAlignment="Center" FontSize="10" Foreground="#f0b64b" Margin="8,0" />
                  </UniformGrid>
                </StackPanel>
              </Border>
              <!-- Options: grupp + höjd/rack + rekord -->
              <StackPanel Orientation="Horizontal" Spacing="10">
                <ComboBox x:Name="ActiveGroupCob" Width="96" MinHeight="30" SelectionChanged="ActiveGroupCob_Changed" />
                <ComboBox x:Name="HeightCob" Width="76" MinHeight="30" SelectionChanged="HeightCob_Changed" />
                <ComboBox x:Name="RackCob" Width="70" MinHeight="30" SelectionChanged="RackCob_Changed" />
                <CheckBox x:Name="RecordOn" Content="REKORD-LÄGE" Foreground="#8b97a6" Checked="RecordToggled" Unchecked="RecordToggled" />
                <TextBlock x:Name="RecordInfo" Text="" Foreground="#8b97a6" FontSize="11" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>

            <!-- ordning -->
            <ItemsControl Grid.Row="3" x:Name="OrderList" Margin="0,10,0,0" MaxHeight="220">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#121820" CornerRadius="8" Padding="10,5" Margin="0,2" BorderBrush="#1f2731" BorderThickness="1">
                    <TextBlock FontFamily="JetBrains Mono" FontSize="12" Foreground="#e6ebf3" Text="{Binding}" VerticalAlignment="Center" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Höger: tidy kort med totaler/ordning + status -->
          <Border Grid.Column="1" Background="#0e141d" CornerRadius="10" Padding="12" BorderBrush="#1f2731" BorderThickness="1">
            <StackPanel Spacing="10">
              <TextBlock Text="STATUS" FontSize="10" Foreground="#8b97a6" />
              <TextBlock x:Name="CompStatus" Text="öppna ett möte på Invägning-sidan" Foreground="#e6ebf3" FontSize="13" TextWrapping="Wrap" />
              <TextBlock Text="ORDNING (kommer)" FontSize="10" Foreground="#8b97a6" />
              <TextBlock x:Name="NextMiniOrder" Text="" Foreground="#e6ebf3" FontFamily="JetBrains Mono" FontSize="12" TextWrapping="Wrap" />
              <TextBlock x:Name="PinEcho" Text="" Foreground="#8b97a6" FontSize="11" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
        <Grid x:Name="PageJudge" IsVisible="False">
          <TextBlock Text="Domare — GOOD/BAD-panel, timer, plattor."
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PageResults" IsVisible="False">
          <TextBlock Text="Resultat — export till SSF/db.steelmeet.se."
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Databas-sidan: direkt koppling till db.steelmeet.se -->
        <Grid x:Name="PageDb" IsVisible="False" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="FetchBtn" Classes="sm-button" Content="HÄMTA TÄVLINGAR" MinWidth="220" MinHeight="46" />
              <Button x:Name="FlushBtn" Classes="sm-button" Content="FLUSH KÖ" MinHeight="46" />
            </StackPanel>
            <TextBlock x:Name="DbStatus" Text="klart." Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,12">
            <ListBox x:Name="CompList" Background="Transparent" BorderThickness="0" FontFamily="JetBrains Mono" Foreground="{StaticResource Text}" FontSize="13" />
          </ScrollViewer>
        </Grid>

        <Grid x:Name="PageSettings" IsVisible="False">
          <TextBlock Text="Inställningar — bindning till SSF-konto, lagring." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <!-- fotrad -->
      <Border Grid.Row="2" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,6">
        <TextBlock Text="STEELMEET 2.0 — OFFLINE BEFORE EVERYTHING ELSE" FontSize="10" Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" />
      </Border>
    </Grid>
  </Grid>
</Window>
