<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Steelmeet2.MainWindow"
        Title="STEELMEET 2.0" Width="1180" Height="780"
        Background="#0b0f14" TransparencyLevelHint="None"
       
        FontSize="15">
  <Window.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0b0f14" />
    <SolidColorBrush x:Key="Surface" Color="#121820" />
    <SolidColorBrush x:Key="Surface2" Color="#172030" />
    <SolidColorBrush x:Key="Border" Color="#1f2731" />
    <SolidColorBrush x:Key="Text" Color="#e6ebf3" />
    <SolidColorBrush x:Key="Muted" Color="#8b97a6" />
    <SolidColorBrush x:Key="Accent" Color="#4f8cff" />
    <SolidColorBrush x:Key="Ok" Color="#37c98b" />
    <SolidColorBrush x:Key="Bad" Color="#ff5f68" />
  </Window.Resources>

  <Grid ColumnDefinitions="230,*" >
    <!-- Vänster-räl: SteamOS-kompakt tile-nav -->
    <Border Grid.Column="0" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
      <StackPanel Spacing="6" Margin="10,14">
        <TextBlock Text="STEELMEET" FontWeight="Black" FontSize="22" Foreground="{StaticResource Text}" Margin="6,0,0,2" />
        <TextBlock Text="2.0" FontFamily="JetBrains Mono" FontSize="11" Foreground="{StaticResource Accent}" Margin="6,0,0,18" />
        <ListBox x:Name="NavList" Background="Transparent" BorderThickness="0" SelectedIndex="0" SelectionChanged="Nav_SelectionChanged">
          <ListBoxItem Padding="12,11"><TextBlock Text="Invägning" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Tävling" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Domare" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Resultat" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Databas" /></ListBoxItem>
          <ListBoxItem Padding="12,11"><TextBlock Text="Inställningar" /></ListBoxItem>
        </ListBox>
        <Border Height="46" />
        <Border Background="{StaticResource Surface}" CornerRadius="8" Padding="10" BorderBrush="{StaticResource Border}" BorderThickness="1">
          <TextBlock x:Name="NetStatus" Text="● ONLINE" Foreground="{StaticResource Ok}" FontFamily="JetBrains Mono" FontSize="12" />
        </Border>
      </StackPanel>
    </Border>

    <!-- Innehåll -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
      <!-- topprad -->
      <Border Grid.Row="0" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="18,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="PageTitle" Text="Invägning" FontSize="19" Foreground="{StaticResource Text}" VerticalAlignment="Center" />
          <TextBlock x:Name="Clock" Grid.Column="1" Text="--:--" Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- sidor (One per navigering, enkel visibility-växel) -->
      <Grid Grid.Row="1" Margin="18,14">
        <!-- Invägning: möteshantering + Excel + DB -->
        <Grid x:Name="PageWeighIn" IsVisible="True" RowDefinitions="Auto,*,Auto" Margin="0">
          <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox x:Name="MeetName" Watermark="Mötesnamn" Width="220" />
              <TextBox x:Name="MeetDate" Watermark="yyyy-mm-dd" Width="110" />
              <TextBox x:Name="MeetPin" Watermark="PIN" PasswordChar="*" Width="80" />
              <Button x:Name="NewMeetBtn" Classes="sm-button" Content="SKAPA" MinHeight="36" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="LoadMeetsBtn" Classes="sm-button" Content="LISTA MÖTEN" MinHeight="36" />
              <ComboBox x:Name="MeetsCombo" Width="320" MinHeight="36" />
              <Button x:Name="OpenMeetBtn" Classes="sm-button" Content="ÖPPNA" MinHeight="36" />
              <Button x:Name="ImportBtn" Classes="sm-button" Content="IMPORTERA EXCEL" MinHeight="36" />
              <Button x:Name="ExportBtn" Classes="sm-button" Content="EXPORTERA EXCEL" MinHeight="36" />
              <Button x:Name="PublishBtn" Classes="sm-button" Content="PUBLICERA" MinHeight="36" />
            </StackPanel>
          </StackPanel>
          <Border Grid.Row="1" Background="#121820" BorderBrush="#1f2731" BorderThickness="1" CornerRadius="8" Padding="2">
            <DataGrid x:Name="WeighInDg" AutoGenerateColumns="False" HeadersVisibility="Column"
                      CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                      GridLinesVisibility="Vertical" RowHeight="30" FontFamily="JetBrains Mono" FontSize="12"
                      Foreground="#e6ebf3" Background="#121820" RowBackground="#121820" 
                      HorizontalGridLinesBrush="#1f2731" VerticalGridLinesBrush="#1f2731">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Grupp" Binding="{Binding groupNumber}" Width="56" />
                <DataGridTextColumn Header="Namn" Binding="{Binding name}" Width="170" />
                <DataGridTextColumn Header="Lot" Binding="{Binding lotNumber}" Width="46" />
                <DataGridTextColumn Header="Klass" Binding="{Binding weightClass}" Width="56" />
                <DataGridTextColumn Header="Kategori" Binding="{Binding category}" Width="110" />
                <DataGridTextColumn Header="Licens" Binding="{Binding licenceNumber}" Width="70" />
                <DataGridTextColumn Header="Förening" Binding="{Binding accossiation}" Width="120" />
                <DataGridTextColumn Header="Vikt" Binding="{Binding bodyWeight}" Width="56" />
                <DataGridTextColumn Header="Höjd B" Binding="{Binding squatHeight}" Width="56" />
                <DataGridTextColumn Header="Infällt" Binding="{Binding tilted}" Width="52" />
                <DataGridTextColumn Header="Böj" Binding="{Binding s1}" Width="52" />
                <DataGridTextColumn Header="Höjd Bänk" Binding="{Binding benchHeight}" Width="56" />
                <DataGridTextColumn Header="Rack" Binding="{Binding benchRack}" Width="52" />
                <DataGridTextColumn Header="Avlyft" Binding="{Binding liftoff}" Width="52" />
                <DataGridTextColumn Header="Bänk" Binding="{Binding b1}" Width="52" />
                <DataGridTextColumn Header="Mark" Binding="{Binding d1}" Width="52" />
              </DataGrid.Columns>
            </DataGrid>
          </Border>
          <TextBlock Grid.Row="2" x:Name="WeighStatus" Text="klart." Foreground="#8b97a6" FontFamily="JetBrains Mono" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" />
        </Grid>
        <Grid x:Name="PageComp" IsVisible="False">
          <TextBlock Text="Tävling — lifting order / försökeditorn kommer här."
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PageJudge" IsVisible="False">
          <TextBlock Text="Domare — GOOD/BAD-panel, timer, plattor."
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <Grid x:Name="PageResults" IsVisible="False">
          <TextBlock Text="Resultat — export till SSF/db.steelmeet.se."
                     Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>

        <!-- Databas-sidan: direkt koppling till db.steelmeet.se -->
        <Grid x:Name="PageDb" IsVisible="False" RowDefinitions="Auto,*,Auto">
          <StackPanel Grid.Row="0" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <Button x:Name="FetchBtn" Classes="sm-button" Content="HÄMTA TÄVLINGAR" MinWidth="220" MinHeight="46" />
              <Button x:Name="FlushBtn" Classes="sm-button" Content="FLUSH KÖ" MinHeight="46" />
            </StackPanel>
            <TextBlock x:Name="DbStatus" Text="klart." Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" Margin="0,12">
            <ListBox x:Name="CompList" Background="Transparent" BorderThickness="0" FontFamily="JetBrains Mono" Foreground="{StaticResource Text}" FontSize="13" />
          </ScrollViewer>
        </Grid>

        <Grid x:Name="PageSettings" IsVisible="False">
          <TextBlock Text="Inställningar — bindning till SSF-konto, lagring." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Grid>

      <!-- fotrad -->
      <Border Grid.Row="2" Background="#0e141d" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="18,6">
        <TextBlock Text="STEELMEET 2.0 — OFFLINE BEFORE EVERYTHING ELSE" FontSize="10" Foreground="{StaticResource Muted}" FontFamily="JetBrains Mono" />
      </Border>
    </Grid>
  </Grid>
</Window>
