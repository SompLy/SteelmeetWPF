<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Steelmeet2.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <!-- DB STEELMEET look: kompakt, mörk, accent-blå — portad från db.steelmeet.se/styles.css -->
    <Style Selector="Button.sm-button">
      <Setter Property="Background" Value="#172030" />
      <Setter Property="Foreground" Value="#e6ebf3" />
      <Setter Property="BorderBrush" Value="#1f2731" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontFamily" Value="Inter" />
    </Style>
    <Style Selector="Button.sm-button:hover">
      <Setter Property="Background" Value="#1f2a3d" />
      <Setter Property="BorderBrush" Value="#4f8cff" />
    </Style>
    <Style Selector="Button.sm-button:pressed">
      <Setter Property="Background" Value="#4f8cff" />
    </Style>
    <Style Selector="Button.sm-wplus">
      <Setter Property="Background" Value="#12331f" />
      <Setter Property="Foreground" Value="#37c98b" />
      <Setter Property="BorderBrush" Value="#1f4d33" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="JetBrains Mono" />
    </Style>
    <Style Selector="Button.sm-wplus:hover">
      <Setter Property="Background" Value="#175231" />
    </Style>
    <Style Selector="Button.sm-wminus">
      <Setter Property="Background" Value="#3a1518" />
      <Setter Property="Foreground" Value="#ff8a90" />
      <Setter Property="BorderBrush" Value="#5b1d22" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontFamily" Value="JetBrains Mono" />
    </Style>
    <Style Selector="Button.sm-wminus:hover">
      <Setter Property="Background" Value="#5b1d22" />
    </Style>
    <Style Selector="ListBox">
      <Setter Property="Background" Value="#121820" />
      <Setter Property="BorderBrush" Value="#1f2731" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="transparent" />
      <Setter Property="Foreground" Value="#8b97a6" />
      <Setter Property="FontFamily" Value="Inter" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="#172030" />
      <Setter Property="Foreground" Value="#e6ebf3" />
      <Setter Property="BorderBrush" Value="#4f8cff" />
    </Style>
    <Style Selector="ScrollBar">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
  </Application.Styles>
</Application>
